{
  "name": "replay-theater",
  "version": "1.2.0",
  "description": "Auditor passo a passo de diffs e modificações de código realizadas pelo assistente.",
  "author": {
    "name": "Anthropic & Antigravity"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/replay-collector.js\""
          }
        ]
      }
    ]
  },
  "commands": [
    "./commands/replay.md"
  ]
}
