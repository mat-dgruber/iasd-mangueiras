rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para Conteúdos Públicos (Eventos, Comunicados, Ministérios, Avisos)
    match /eventos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /comunicados/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ministerios/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /avisos_horarios/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /configuracoes/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos de Oração e Estudos Bíblicos
    // Qualquer visitante pode enviar; somente líderes autenticados podem ler, atualizar ou excluir.
    match /pedidos_oracao/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Coleção de Usuários Administrativos
    match /usuarios_admin/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
