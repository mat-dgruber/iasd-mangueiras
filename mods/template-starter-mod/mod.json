{
  "name": "template-starter-mod",
  "version": "1.2.0",
  "description": "Boilerplate canônico para criação de mods para Claude Code e OpenClaude.",
  "author": "Antigravity Engineering",
  "type": "mod",
  "commands": [
    {
      "name": "mod-status",
      "description": "Exibe status e telemetria do mod no terminal",
      "source": "./commands/mod-status.md"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./bin/mod-hook.js --event PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./bin/mod-hook.js --event PostToolUse"
          }
        ]
      }
    ]
  },
  "ui": {
    "band": {
      "enabled": true,
      "handler": "renderPromptBand"
    }
  }
}
