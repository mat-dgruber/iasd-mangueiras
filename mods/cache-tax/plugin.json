{
  "name": "cache-tax",
  "version": "1.3.0",
  "description": "Alerta sobre expiração de cache de prompt (cold cache) e previne gastos excessivos com reprocessamento desnecessário de contexto.",
  "author": {
    "name": "karanb192 & Antigravity"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/cache-check.js\"",
            "statusMessage": "Verificando integridade e aquecimento do cache de prompt..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/cache-check.js\" --init"
          }
        ]
      }
    ]
  },
  "commands": [
    "./commands/keepwarm.md"
  ]
}
