{
  "openapi": "3.1.0",
  "info": {
    "title": "IASD Mangueiras API",
    "version": "1.0.0",
    "description": "API Serverless oficial da Igreja Adventista do Sétimo Dia das Mangueiras em Tatuí-SP."
  },
  "servers": [
    {
      "url": "/",
      "description": "API Root"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LicaoHojeResponse": {
        "type": "object",
        "required": [
          "titulo",
          "tema",
          "trimestre",
          "versiculo_dia",
          "referencia",
          "link_cpb",
          "licao_numero"
        ],
        "properties": {
          "titulo": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "trimestre": {
            "type": "string"
          },
          "versiculo_dia": {
            "type": "string"
          },
          "referencia": {
            "type": "string"
          },
          "link_cpb": {
            "type": "string",
            "format": "uri"
          },
          "licao_numero": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Verificar status da API",
        "responses": {
          "200": {
            "description": "API em funcionamento"
          }
        }
      }
    },
    "/livez": {
      "get": {
        "summary": "Liveness Probe",
        "responses": {
          "200": {
            "description": "Processo ativo e respondendo"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness Probe",
        "responses": {
          "200": {
            "description": "Serviços externos e banco prontos"
          },
          "503": {
            "description": "Infraestrutura indisponível"
          }
        }
      }
    },
    "/api/youtube/latest": {
      "get": {
        "summary": "Listar vídeos recentes do canal",
        "responses": {
          "200": {
            "description": "Lista dos últimos vídeos e transmissões"
          }
        }
      }
    },
    "/api/youtube/catalog": {
      "get": {
        "summary": "Listar catálogo de vídeos",
        "responses": {
          "200": {
            "description": "Catálogo de vídeos"
          }
        }
      }
    },
    "/api/youtube/playlist/{category}": {
      "get": {
        "summary": "Listar vídeos de uma playlist",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vídeos da playlist"
          }
        }
      }
    },
    "/api/youtube/presente7": {
      "get": {
        "summary": "Listar episódios do Presente 7",
        "parameters": [
          {
            "name": "max_results",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Episódios do Presente 7"
          }
        }
      }
    },
    "/api/youtube/live": {
      "get": {
        "summary": "Verificar status de transmissão ao vivo",
        "responses": {
          "200": {
            "description": "Status atual do culto ao vivo"
          }
        }
      }
    },
    "/api/licao/hoje": {
      "get": {
        "summary": "Obter lição de hoje",
        "responses": {
          "200": {
            "description": "Lição do dia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LicaoHojeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/contato": {
      "post": {
        "summary": "Enviar mensagem de contato",
        "responses": {
          "200": {
            "description": "Mensagem recebida com sucesso"
          },
          "422": {
            "description": "Campos obrigatórios ausentes"
          }
        }
      }
    },
    "/api/oracao": {
      "post": {
        "summary": "Enviar pedido de oração",
        "responses": {
          "200": {
            "description": "Pedido de oração recebido com sucesso"
          },
          "422": {
            "description": "Campos obrigatórios ausentes"
          }
        }
      }
    }
  }
}
